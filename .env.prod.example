# ==============================================================================
# Production Environment Configuration (IDCloudHost VPS / Docker Compose Prod)
# Copy this file to `.env.prod` (never commit `.env.prod` to Git!)
# ==============================================================================

# Public Domain for Automatic HTTPS (Let's Encrypt / ZeroSSL via Caddy)
# - Use `:80` initially if testing directly via VPS IP address (e.g. http://103.x.x.x)
# - Change to your domain once DNS A-record points to VPS IP (e.g. oms.fransalwan.my.id)
APP_DOMAIN=:80

# PostgreSQL 16 Production Credentials
DB_USER=spg_prod
DB_PASSWORD=replace_with_strong_random_db_password
DB_NAME=secure_payment_gateway
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Redis 7 Production Auth
REDIS_PASSWORD=replace_with_strong_random_redis_password

# Cryptographic Keys
# IMPORTANT: AES_SECRET_KEY must be EXACTLY 32 ASCII characters (256-bit AES-GCM)
AES_SECRET_KEY=ChangeMeToExact32ByteSecretKey!!
HMAC_SECRET_KEY=replace_with_random_hmac_secret_key
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_SECRET=replace_with_random_webhook_secret_key
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=120

# Optional: Gemini API Key for Live LLM WhatsApp/IG Order Extraction
# (Automatically falls back to deterministic regex/SKU parser if left empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

