# Application Settings
APP_PORT=8080
APP_ENV=development

# Database Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=secure_payment_gateway
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Redis Cache & Lock Settings
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Message Broker (Asynchronous AI Worker Pipeline & Event Bus)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Optional full connection URI override (e.g. for cloud/managed RabbitMQ):
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Security Settings
# AES_SECRET_KEY must be exactly 32 bytes for AES-256 (32 characters or 64 hex chars)
AES_SECRET_KEY=01234567890123456789012345678901
HMAC_SECRET_KEY=spg-secret-hmac-key-for-signatures
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_SECRET=spg-webhook-secret-hmac-2026
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=120

# AI Order Parser (Optional: uses deterministic NLP fallback when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Background Queue Worker
ENABLE_EMBEDDED_WORKER=true

